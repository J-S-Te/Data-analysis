# data_analysis 环境变量模板（真实值经部署 Secret 注入，不入 Git；.env.local 权限 0600）

# --- 平台接入（onboard 自动写入） ---
PLATFORM_BASE_URL=http://localhost:8081
OIDC_ISSUER=http://localhost:18090/realms/basic-platform
OIDC_BACKCHANNEL_BASE_URL=
OIDC_CLIENT_ID=data_analysis-dev-web
OIDC_CLIENT_SECRET=REPLACE_WITH_STRONG_SECRET
OIDC_REDIRECT_URI=http://localhost:8081/data_analysis/auth/callback
OIDC_SCOPES=openid profile
OIDC_TENANT_ID=
APP_PUBLIC_ORIGIN=http://localhost:8081
COOKIE_SECURE=false
OIDC_CODEC_KEY=REPLACE_WITH_64_HEX
APP_PUBLIC_URL=http://localhost:8081/data_analysis/
APP_PATH_PREFIX=/data_analysis
PLATFORM_APPLICATION_ID=
PLATFORM_APPLICATION_CODE=data_analysis
PLATFORM_ENVIRONMENT_CODE=dev
PLATFORM_DOCKER_NETWORK=

# --- 授权目录 / 审计机器 Client（onboard 创建，各自独立） ---
PLATFORM_AUTHORIZATION_CATALOG_SYNC_ENABLED=true
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_ID=
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_SECRET=
PLATFORM_AUTHORIZATION_CATALOG_APPLICATION_ID=
# 推荐统一使用 PLATFORM_AUDIT_*；旧 AUDIT_INGEST_* 仍兼容。
PLATFORM_AUDIT_CLIENT_ID=
PLATFORM_AUDIT_CLIENT_SECRET=
# prod 默认要求审计可用并在 /readyz 缺配时返回 503；开发环境可显式设 false。
PLATFORM_AUDIT_REQUIRED=false

# --- 聚合库 ---
# 分体键（SEC-N10/SEC-N10c）：compose 用 DASHBOARD_MYSQL_PASSWORD 拼装容器内 DSN，
# docker-local.sh 生成 .env.local 时会随机改写这两个口令。
DASHBOARD_MYSQL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DASHBOARD_MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_STRONG_PASSWORD
DASHBOARD_MYSQL_USER=dashboard
DASHBOARD_MYSQL_HOST=127.0.0.1:3306
DASHBOARD_MYSQL_DATABASE=dashboard_aggregation
# 拼接式明文 DSN 已移除：模板不再内联口令（SEC-N10c）。
#   - 容器运行：DSN 由 compose 用上面分体键拼装后经 environment 注入
#     （environment 优先级高于 env_file，四个 data-analysis 服务均如此）；
#   - 宿主直连：按分体键自行拼装，形如
#     user:password@tcp(host:port)/db?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci
DASHBOARD_MYSQL_DSN=

# --- 业务库只读账号（夜间同步，Secret 注入；设计方案 §5.4） ---
CONTRACT_READ_DSN=
CRM_READ_DSN=
PROJECT_READ_DSN=
# REPORT_READ_DSN=   # 报告子系统（待就绪）
# SETTLEMENT_READ_DSN=  # 结算子系统（待就绪）
# REIMBURSEMENT_READ_DSN=  # 报销子系统（待就绪）

# --- 平台 owner-directory（OQ-D1：接口已存在，scope=owner_directory.read） ---
OWNER_DIRECTORY_ENDPOINT=http://localhost:8081/api/v1/internal/owner-directory
OWNER_DIRECTORY_TOKEN_URL=http://localhost:18090/realms/basic-platform/protocol/openid-connect/token
OWNER_DIRECTORY_CLIENT_ID=
OWNER_DIRECTORY_CLIENT_SECRET=

# --- Metabase（仅内网） ---
METABASE_INTERNAL_URL=http://metabase:3000
METABASE_EMBEDDING_SECRET=REPLACE_WITH_METABASE_EMBEDDING_SECRET
METABASE_SITE_URL=http://localhost:8081/data_analysis

# --- worker 开关（开发/联调） ---
AGGREGATION_WORKER_DISABLED=false
ALERT_WORKER_DISABLED=false

# 数据分析通过平台 OAuth 分别访问合同/项目 internal/dashboard；禁止复用同一个凭据。
# 两组凭据由基础平台应用接入流程生成并写入本地运行配置。
MACHINE_TOKEN_URL=http://platform-api:8080/oauth2/token
MACHINE_TOKEN_ISSUER=basic-platform
MACHINE_TOKEN_AUDIENCE=basic-platform-application
CONTRACT_MACHINE_CLIENT_ID=PENDING_ONBOARDING
CONTRACT_MACHINE_CLIENT_SECRET=PENDING_ONBOARDING
CONTRACT_MACHINE_TOKEN_SCOPE=dashboard.contract.read
PROJECT_MACHINE_CLIENT_ID=PENDING_ONBOARDING
PROJECT_MACHINE_CLIENT_SECRET=PENDING_ONBOARDING
PROJECT_MACHINE_TOKEN_SCOPE=dashboard.project.read
CONTRACT_INTERNAL_URL=http://contract-api:8081/internal/v1/dashboard
PROJECT_INTERNAL_URL=http://project-api:8082/internal/v1/dashboard

# --- 以下为 SEC-N10c 补齐：配置读取但模板此前缺失的键（留空=与键不存在时行为一致） ---
# worker 单次运行开关（本地/巡检）
AGGREGATION_ONCE=false
ALERT_WORKER_ONCE=false
# 授权目录 manifest 路径（authz-catalog 工具读取）
AUTHZ_MANIFEST_PATH=
# OIDC 角色上限与角色配置哈希（onboard 可下发；留空沿用运行时默认）
OIDC_MAX_ROLES=
OIDC_ROLE_CONFIG_HASH=
# 旧审计 ingest 键（仅作 PLATFORM_AUDIT_* 缺省时的兼容回退，推荐只用 PLATFORM_AUDIT_*）
AUDIT_INGEST_CLIENT_ID=
AUDIT_INGEST_CLIENT_SECRET=

