# data_analysis 环境变量模板（真实值经部署 Secret 注入，不入 Git；.env.local 权限 0600）

# --- 平台接入（onboard 自动写入） ---
PLATFORM_BASE_URL=http://localhost:8081
OIDC_ISSUER=http://localhost:18090/realms/basic-platform
OIDC_BACKCHANNEL_BASE_URL=
OIDC_CLIENT_ID=data_analysis-dev-web
OIDC_CLIENT_SECRET=REPLACE_WITH_STRONG_SECRET
OIDC_REDIRECT_URI=http://localhost:8081/data_analysis/auth/callback
OIDC_SCOPES=openid profile
OIDC_TENANT_ID=
OIDC_BACKCHANNEL_BASE_URL=
APP_PUBLIC_ORIGIN=http://localhost:8081
COOKIE_SECURE=false
OIDC_CODEC_KEY=REPLACE_WITH_64_HEX
APP_PUBLIC_URL=http://localhost:8081/data_analysis/
APP_PATH_PREFIX=/data_analysis
PLATFORM_APPLICATION_ID=
PLATFORM_APPLICATION_CODE=data_analysis
PLATFORM_ENVIRONMENT_CODE=dev
PLATFORM_DOCKER_NETWORK=

# --- 授权目录 / 审计机器 Client（onboard 创建，各自独立） ---
PLATFORM_AUTHORIZATION_CATALOG_SYNC_ENABLED=true
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_ID=
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_SECRET=
PLATFORM_AUTHORIZATION_CATALOG_APPLICATION_ID=
AUDIT_INGEST_CLIENT_ID=
AUDIT_INGEST_CLIENT_SECRET=

# --- 聚合库 ---
DASHBOARD_MYSQL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DASHBOARD_MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_STRONG_PASSWORD
DASHBOARD_MYSQL_DSN=dashboard:REPLACE@tcp(dashboard-mysql:3306)/dashboard_aggregation?parseTime=true&charset=utf8mb4

# --- 业务库只读账号（夜间同步，Secret 注入；设计方案 §5.4） ---
CONTRACT_READ_DSN=
CRM_READ_DSN=
PROJECT_READ_DSN=
# REPORT_READ_DSN=   # 报告子系统（待就绪）
# SETTLEMENT_READ_DSN=  # 结算子系统（待就绪）
# REIMBURSEMENT_READ_DSN=  # 报销子系统（待就绪）

# --- 平台 owner-directory（OQ-D1：接口已存在，scope=owner_directory.read） ---
OWNER_DIRECTORY_ENDPOINT=http://localhost:8081/api/v1/internal/owner-directory
OWNER_DIRECTORY_TOKEN_URL=http://localhost:18090/realms/basic-platform/protocol/openid-connect/token
OWNER_DIRECTORY_CLIENT_ID=
OWNER_DIRECTORY_CLIENT_SECRET=

# --- Metabase（仅内网） ---
METABASE_INTERNAL_URL=http://metabase:3000
METABASE_EMBEDDING_SECRET=REPLACE_WITH_METABASE_EMBEDDING_SECRET
METABASE_SITE_URL=http://localhost:8081/data_analysis

# --- worker 开关（开发/联调） ---
AGGREGATION_WORKER_DISABLED=false
ALERT_WORKER_DISABLED=false
