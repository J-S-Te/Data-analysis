# data_analysis 环境变量模板（真实值经部署 Secret 注入，不入 Git；.env.local 权限 0600）

# --- 平台接入（onboard 自动写入） ---
PLATFORM_BASE_URL=http://localhost:8081
OIDC_ISSUER=http://localhost:18090/realms/basic-platform
OIDC_BACKCHANNEL_BASE_URL=
OIDC_CLIENT_ID=data_analysis-dev-web
OIDC_CLIENT_SECRET=REPLACE_WITH_STRONG_SECRET
OIDC_REDIRECT_URI=http://localhost:8081/data_analysis/auth/callback
OIDC_SCOPES=openid profile
OIDC_TENANT_ID=
APP_PUBLIC_ORIGIN=http://localhost:8081
COOKIE_SECURE=false
# 平台及全部RP升级就绪后再启用；业务期限由基础平台统一管理。
CENTRAL_SESSION_ENABLED=false
CENTRAL_SESSION_PUBLIC_BASE_URL=
# 中央会话只读窗口缓存 TTL（毫秒）。0=关闭（每次都向中央会话服务校验，行为与引入缓存前一致）；
# 正整数=启用，上限 5000ms，超出按 5000 收敛；非法值回落默认 2000ms。关闭不会降低安全性。
CENTRAL_SESSION_CACHE_MS=0
OIDC_CODEC_KEY=REPLACE_WITH_64_HEX
# --- 浏览器会话双期限（空闲 30m + 绝对 8h） ---
# 空闲仅由鼠标/键盘活动经 POST /api/v1/auth/activity 续期；绝对期限到点强制重登、不受活动影响。
# 空闲范围 1m~24h，绝对必须大于空闲；非法值让 dashboard-api 启动失败（fail-closed）。
# 旧键 OIDC_SESSION_TTL 仅在新绝对键缺省时作为绝对期限，避免旧环境被静默放大到 8h。
OIDC_SESSION_IDLE_TTL=30m
OIDC_SESSION_ABSOLUTE_TTL=8h
APP_PUBLIC_URL=http://localhost:8081/data_analysis/
APP_PATH_PREFIX=/data_analysis
PLATFORM_APPLICATION_ID=
PLATFORM_APPLICATION_CODE=data_analysis
PLATFORM_ENVIRONMENT_CODE=dev
PLATFORM_DOCKER_NETWORK=

# --- 授权目录 / 审计机器 Client（onboard 创建，各自独立） ---
PLATFORM_AUTHORIZATION_CATALOG_SYNC_ENABLED=true
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_ID=
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_SECRET=
PLATFORM_AUTHORIZATION_CATALOG_APPLICATION_ID=
# 推荐统一使用 PLATFORM_AUDIT_*；旧 AUDIT_INGEST_* 仍兼容。
PLATFORM_AUDIT_CLIENT_ID=
PLATFORM_AUDIT_CLIENT_SECRET=
# prod 默认要求审计可用并在 /readyz 缺配时返回 503；开发环境可显式设 false。
PLATFORM_AUDIT_REQUIRED=false
# 已投递审计 outbox 行的本地保留期（天）。0/缺省=关闭清理（delivered 行永久保留，
# 它们是仅存在于本地的审计证据）；正整数=启用，删除 delivery_status='delivered'
# 且 delivered_at 早于该天数的行，按批删除。非数字或负数同样视为关闭。
AUDIT_OUTBOX_DELIVERED_RETENTION_DAYS=

# --- 聚合库 ---
# 分体键（SEC-N10/SEC-N10c）：compose 用 DASHBOARD_MYSQL_PASSWORD 拼装容器内 DSN，
# docker-local.sh 生成 .env.local 时会随机改写这两个口令。
DASHBOARD_MYSQL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DASHBOARD_MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_STRONG_PASSWORD
DASHBOARD_MYSQL_USER=dashboard
DASHBOARD_MYSQL_HOST=127.0.0.1:3306
DASHBOARD_MYSQL_DATABASE=dashboard_aggregation
# 拼接式明文 DSN 已移除：模板不再内联口令（SEC-N10c）。
#   - 容器运行：DSN 由 compose 用上面分体键拼装后经 environment 注入
#     （environment 优先级高于 env_file，四个 data-analysis 服务均如此）；
#   - 宿主直连：按分体键自行拼装，形如
#     user:password@tcp(host:port)/db?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci
DASHBOARD_MYSQL_DSN=

# --- 看板业务日时区 ---
# “今天/到期”等业务日边界按此 IANA 时区计算；存储、同步与时间戳仍全部使用 UTC。
# 空值取默认 Asia/Shanghai；非法值让 dashboard-api 启动失败（fail-closed），不静默回退。
DASHBOARD_TIMEZONE=Asia/Shanghai

# 财务看板唯一来源：integration 保持原有业务联动；standard 读取已发布标准经营事实。
# 标准来源需先执行版本迁移，再由全租户范围且有聚合管理权限的管理员预览/发布。
# 两种来源不混加；非法值启动失败，standard未发布时明确不可用。
# 外部业务同步总开关：默认true保留现有联动，false不解析或装配HTTP/只读DSN/项目投影/合同历史摘要任务。
# 与财务来源和嵌入开关独立；不清历史快照/既有队列，关闭前先收口在途导入和同步。
# API、聚合Worker和告警Worker的许可消费者与本地功能保留；非 true/false 值启动失败。
DASHBOARD_INTEGRATION_SYNC_ENABLED=true
DASHBOARD_FINANCE_SOURCE=integration

# --- 看板“审批中”口径（BIZ-DATA-06） ---
# status    = 历史口径，用 dim_contract.status='pending' 近似（会漏计合同仍为 active 的变更审批）。
# instances = 权威口径，按 dim_contract_approval 存在 status='running' 的审批实例计数。
# 切换前置条件（硬校验）：合同库只读账号需 SELECT con_approval_instance；contract_approval
# 同步通道必须已至少成功一轮（sync_source.last_success_at 非空），否则 dashboard-api 启动失败
# 或运行期拒绝返回，不会静默退化成 0。默认 status，行为不变。
DASHBOARD_APPROVAL_SOURCE=status

# --- 可选业务库只读兼容来源（默认留空，Secret 注入） ---
CONTRACT_READ_DSN=
CRM_READ_DSN=
PROJECT_READ_DSN=
SETTLEMENT_READ_DSN=
# REPORT_READ_DSN=   # 报告子系统（待就绪）
# REIMBURSEMENT_READ_DSN=  # 报销子系统（待就绪）
# 生产 Compose 从根 .env 向 aggregation-worker 注入以上 4 个只读 DSN；
# 空值表示该源不登记，不会伪造空数据。

# --- 平台 owner-directory（OQ-D1：接口已存在，scope=owner_directory.read） ---
OWNER_DIRECTORY_ENDPOINT=http://localhost:8081/api/v1/internal/owner-directory
OWNER_DIRECTORY_TOKEN_URL=http://localhost:18090/realms/basic-platform/protocol/openid-connect/token
OWNER_DIRECTORY_CLIENT_ID=
OWNER_DIRECTORY_CLIENT_SECRET=

# --- Metabase（仅内网；原生摘要始终保留） ---
# 默认 true 兼容原有嵌入；false 不初始化嵌入桥，无需 URL、secret、独立来源。
# false 时原生摘要仍遵守认证、权限、许可及实际来源同步状态，不产生模拟数据。
DASHBOARD_EMBED_ENABLED=true
METABASE_INTERNAL_URL=http://metabase:3000
# Must use a distinct cookie domain, not another port or sibling subdomain.
# embed-proxy 只对“精确等于本值”的 Origin 回显 CORS（规范化后全等，不做前缀/子域/端口通配）；
# `Origin: null`（沙箱 iframe、file://、部分跳转重定向）及任何不透明源一律不放行。
# 未配置（空值）时仍不回显 CORS：嵌入页的跨源读取/一次性令牌请求会失败（业务 API 不受影响）。
# 留空仅使已启用嵌入能力返回配置缺失；完整原生模式应显式设 DASHBOARD_EMBED_ENABLED=false。
# Production HTTPS edge forwards only the embedded proxy to gateway port 8082.
BI_EMBED_PUBLIC_ORIGIN=
METABASE_EMBEDDING_SECRET=REPLACE_WITH_METABASE_EMBEDDING_SECRET
METABASE_SITE_URL=http://localhost:8081/data_analysis

# --- worker 开关（开发/联调） ---
AGGREGATION_WORKER_DISABLED=false
ALERT_WORKER_DISABLED=false
# 跨实例轮次重叠守卫（BIZ-DATA-08）：同一租户存在未结束且开始更早的 sync_run 轮次时，
# 本轮跳过 precompute（派生事实，跳过不损失源数据）并 WARN。
# warn（默认）= 只 WARN、当轮不失败；enforce = 同样跳过，但把重叠计为当轮错误（其它来源照常完成）。
# 非法值让 aggregation-worker 启动失败（fail-closed）。多实例/滚动升级期建议保持 warn 观察，
# 收敛后切 enforce；发布顺序约束见 docs/dim-sync-concurrency.md。
AGG_RUN_OVERLAP_GUARD=warn
# 告警生命周期收敛（离开窗口自动 CLOSED / 条件重新命中自动重开）。
# 默认 false = 保持现网"只增不关"行为；产品策略确认后再开启，详见 docs/alert-lifecycle.md。
ALERT_AUTO_RESOLVE=false
# 收敛策略细项（仅 ALERT_AUTO_RESOLVE=true 时生效；默认值与 internal/alertworker 代码一致）。
# ALERT_CONFIRM_ROUNDS: 连续未命中确认轮数（1..10），达到才自动 CLOSED（去抖，防单轮抖动误关）。
ALERT_CONFIRM_ROUNDS=2
# ALERT_REOPEN_POLICY: auto=条件重新命中时规则自动复开自己关闭的告警；manual=只允许人工复开。
ALERT_REOPEN_POLICY=auto
# ALERT_CLOSE_GUARD_RATIO: 收缩安全阀比例（(0,1]）。本轮命中数低于"未关闭基数×比例"时
# 只 WARN 不关闭，避免上游数据缺失/筛选写错造成批量误关。
ALERT_CLOSE_GUARD_RATIO=0.5

# 合同、项目和结算使用独立平台 OAuth 凭据，每个用途只授最小 scope。
# 凭据由平台受控接入/更新生成，禁止跨业务领域复用 Secret。
MACHINE_TOKEN_URL=http://platform-api:8080/oauth2/token
MACHINE_TOKEN_ISSUER=basic-platform
MACHINE_TOKEN_AUDIENCE=basic-platform-application
CONTRACT_MACHINE_CLIENT_ID=PENDING_ONBOARDING
CONTRACT_MACHINE_CLIENT_SECRET=PENDING_ONBOARDING
CONTRACT_MACHINE_TOKEN_SCOPE=dashboard.contract.read
PROJECT_MACHINE_CLIENT_ID=PENDING_ONBOARDING
PROJECT_MACHINE_CLIENT_SECRET=PENDING_ONBOARDING
PROJECT_MACHINE_TOKEN_SCOPE=dashboard.project.read
# 报告复用项目专用凭据；URL 留空表示未接入，不登记该机器来源。
PROJECT_REPORT_URL=
# 接入后例：http://project-api:8082/internal/v1/dashboard/reports
# 结算财务使用独立 settlement_dashboard_read 用途，不复用项目/合同凭据。
SETTLEMENT_FINANCE_URL=
# 接入后例：http://settlement-api:8085/internal/v1/dashboard/finance
SETTLEMENT_MACHINE_CLIENT_ID=
SETTLEMENT_MACHINE_CLIENT_SECRET=
SETTLEMENT_MACHINE_TOKEN_SCOPE=dashboard.settlement.read
# standard 财务不解析结算 URL/凭据/DSN；总同步开关 false 不装配外部来源。
# 空 URL 不产生假数据；依赖请求失败保留上次成功快照并记录失败。

# API 摘要冗余快照留存：保留近期全部、业务月末及全局最新。
# 仅清理本租户白名单 API 快照，不删除标准财务批次、审计或历史合同发布凭据。
DASHBOARD_SNAPSHOT_RECENT_DAYS=7
DASHBOARD_SNAPSHOT_TREND_MONTHS=24
DASHBOARD_SNAPSHOT_BATCH_SIZE=500
DASHBOARD_SNAPSHOT_MAX_BATCHES=20
# 范围：天 1..3660，月 24..120，每批 1..500，每轮批次 1..20。
# 外部同步启用时显式零值或非法值拒绝启动。
CONTRACT_INTERNAL_URL=http://contract-api:8081/internal/v1/dashboard
PROJECT_INTERNAL_URL=http://project-api:8082/internal/v1/dashboard
# 独立完整项目投影；即使没有 PROJECT_READ_DSN 也可同步项目维表。
PROJECT_PROJECTION_URL=http://project-api:8082/internal/v1/dashboard/projects/snapshot
PROJECT_PROJECTION_HTTP_TIMEOUT=35s
PROJECT_PROJECTION_MAX_PROJECTS=50000
PROJECT_PROJECTION_MAX_BYTES=67108864
PROJECT_PROJECTION_MAX_LINE_BYTES=65536

# --- 以下为 SEC-N10c 补齐：配置读取但模板此前缺失的键（留空=与键不存在时行为一致） ---
# worker 单次运行开关（本地/巡检）
AGGREGATION_ONCE=false
ALERT_WORKER_ONCE=false
# 授权目录 manifest 路径（authz-catalog 工具读取）
AUTHZ_MANIFEST_PATH=
# OIDC 角色上限与角色配置哈希（onboard 可下发；留空沿用运行时默认）
OIDC_MAX_ROLES=
OIDC_ROLE_CONFIG_HASH=
# 旧审计 ingest 键（仅作 PLATFORM_AUDIT_* 缺省时的兼容回退，推荐只用 PLATFORM_AUDIT_*）
AUDIT_INGEST_CLIENT_ID=
AUDIT_INGEST_CLIENT_SECRET=

# Controlled licensing is off until platform enrollment. Each API/Worker has
# independent service credentials/state; never reuse login or audit credentials.
COMMERCIAL_LICENSE_ENABLED=false
# Compatibility mode (all-pass) is an explicit opt-in for never-enrolled
# components; ENABLED=false without it fails startup. Production must use
# ENABLED=true instead of this switch.
COMMERCIAL_LICENSE_COMPATIBILITY=true
COMMERCIAL_LICENSE_INSTANCE_ID=
COMMERCIAL_LICENSE_ENVIRONMENT=
COMMERCIAL_LICENSE_SERVICE_ID=
COMMERCIAL_LICENSE_STATE_PATH=
COMMERCIAL_LICENSE_PLATFORM_PUBLIC_KEY_PATH=
COMMERCIAL_LICENSE_PLATFORM_BASE_URL=
COMMERCIAL_LICENSE_CLIENT_ID=
COMMERCIAL_LICENSE_CLIENT_SECRET=
COMMERCIAL_LICENSE_COVERAGE_DIGEST=
COMMERCIAL_LICENSE_IMAGE_DIGEST=
COMMERCIAL_LICENSE_ALLOW_HTTP=false

# 历史摘要同步默认关闭；独立客户端仅授予 contract.import.report.read。
CONTRACT_IMPORT_SYNC_ENABLED=false
CONTRACT_IMPORT_SUMMARY_URL=
CONTRACT_IMPORT_SYNC_TOKEN_URL=
CONTRACT_IMPORT_SYNC_CLIENT_ID=
CONTRACT_IMPORT_SYNC_CLIENT_SECRET=
CONTRACT_IMPORT_SYNC_SCOPE=contract.import.report.read
# 状态查询与同步开关独立；CLIENT_ID非空时必须完整配置并只读挂载公钥。
CONTRACT_IMPORT_STATUS_ISSUER=
CONTRACT_IMPORT_STATUS_AUDIENCE=
CONTRACT_IMPORT_STATUS_PUBLIC_KEY_PATH=
CONTRACT_IMPORT_STATUS_CLIENT_ID=
CONTRACT_IMPORT_STATUS_TENANT_ID=
CONTRACT_IMPORT_STATUS_CALLER_ENVIRONMENT_CODE=
# 机器报表状态端点还要求绑定平台 OAuth 客户端：必须等于令牌里的 oauth_client_id。
# 该值或 CONTRACT_IMPORT_STATUS_CLIENT_ID 为空时端点整体不挂载（不会挂一个无法证明
# 调用方身份的匿名读取入口），而不是只跳过某项校验。
# 令牌还必须携带非空的 application_id 与 environment_id，否则验签失败。
REPORT_STATUS_MACHINE_OAUTH_CLIENT_ID=
