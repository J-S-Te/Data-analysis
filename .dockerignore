# Deny unknown inputs by default. Host-built Mach-O binaries, developer env
# files and local Docker caches must never enter linux/amd64 image layers.
**
!Dockerfile
!go.mod
!go.sum
!third_party/
!third_party/license-core/
!third_party/license-core/**
!scripts/
!scripts/license-core-sync.sh
!scripts/license-core.sha256
!cmd/
!cmd/**
!internal/
!internal/**
!migrations/
!migrations/**
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.jks
**/*.bak
**/*.backup
**/*.dump
**/dump*.sql
**/.DS_Store
